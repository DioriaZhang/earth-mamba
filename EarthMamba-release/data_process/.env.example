# Copy to .env and export before running cluster scripts.
# CLI flags (--feature_root, --weight_path, etc.) override these when passed explicitly.

# SatMAE ViT-Base weights for embedding (pipeline_cluster_1/2)
WEIGHT_PATH=/hy-tmp/baselines/SatMAE/weights/pretrain-vit-base-e199.pth

# Cluster hypersphere cache (seed / downstream npz)
FEATURE_ROOT=/hy-tmp/datasets/feature

# Pool filter outputs (step1/2/3 txt lists)
OUTPUT_DIR=/hy-tmp/datasets/results

# Normalized 512x512 PNG roots (preprocess_downstream.py)
# OUTPUT_ROOT=/hy-tmp/datasets/Downstream-datasets

# Optional: unlimited PIL decompression for large GeoTIFF (default in scripts)
# PIL_MAX_IMAGE_PIXELS=

# GPU
# CUDA_VISIBLE_DEVICES=0
