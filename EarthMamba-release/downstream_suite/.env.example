# Copy to .env and export before running.
# All paths are YOUR machine — nothing below ships with this folder.

# EarthMamba Python package (directory that contains earth_mamba/)
EARTH_MAMBA_ROOT=/path/to/earth-mamba

# Optional: override base-variant checkpoint resolution
# EARTH_MAMBA_B_RUN=/path/to/pretrain_base/run_name
# EARTH_MAMBA_B_EPOCH=30
# EARTH_MAMBA_B_CKPT=/path/to/earth-mamba-base.pth

# Optional suite root (usually auto-detected)
# DOWNSTREAM_SUITE_ROOT=/path/to/downstream_suite

# DIOR-R progress bar (1=on, 0=off)
# DIOR_R_PROGRESS=1

# GPU
# CUDA_VISIBLE_DEVICES=0
